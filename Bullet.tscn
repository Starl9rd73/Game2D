[sub_resource type="GDScript" id="GDScript_huux0"]
script/source = "extends Area2D

# Tốc độ bay và sát thương của đạn
var speed = 50
var damage = 15

func _physics_process(delta):
	# transform.x giúp đạn luôn bay thẳng về phía mũi nhọn, bất kể súng xoay góc nào
	position += transform.x * speed * delta

# Khi đạn chạm vào một vật thể bất kỳ (Player hoặc Mặt đất)
func _on_body_entered(body):
	# Bỏ qua nếu đạn chạm vào chính Trụ súng (chống tự sát)
	if body.name == \"Turret\":
		return
		
	# Nếu trúng Player thì trừ máu
	if body.name == \"Player\":
		if body.has_method(\"take_damage\"):
			body.take_damage(damage)
			
	# Chỉ tự hủy đạn khi trúng Player hoặc trúng Tường/Mặt đất
	queue_free()

# Khi viên đạn bay ra khỏi phạm vi camera (trượt mục tiêu)
func _on_visible_on_screen_notifier_2d_screen_exited():
	# Xóa viên đạn để giải phóng bộ nhớ, chống giật lag
	queue_free()
"

